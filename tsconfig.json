{
    "extends": "astro/tsconfigs/base",
    "include": [
        ".astro/types.d.ts",
        "**/*"
    ],
  "exclude": [
        "dist",
        "FOR_AGENTS"
    ],
    "compilerOptions": {
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "verbatimModuleSyntax": true,
        "jsx": "react-jsx",
        "jsxImportSource": "react"
    }
}
