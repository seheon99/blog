---
import { cn } from "@/lib/utils";

import BaseLayout from "@/layouts/base-layout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { proseClasses } from "@/lib/prose";
import ReadingProgress from "@/components/post/reading-progress.astro";
import PostHeader from "@/components/post/post-header.astro";
import MarginRail from "@/components/post/margin-rail.astro";
import FootNav from "@/components/post/foot-nav.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const sortedPosts = posts.sort(
    (a, b) => b.data.createdAt.getTime() - a.data.createdAt.getTime(),
  );

  return sortedPosts.map((post) => {
    const currentIndex = sortedPosts.findIndex((p) => p.id === post.id);
    const prevPost =
      currentIndex + 1 < sortedPosts.length
        ? sortedPosts[currentIndex + 1]
        : null;
    const nextPost =
      currentIndex - 1 >= 0 ? sortedPosts[currentIndex - 1] : null;

    return {
      params: { id: post.id },
      props: { post, prevPost, nextPost },
    };
  });
}

interface Props {
  post: CollectionEntry<"posts">;
  prevPost?: CollectionEntry<"posts"> | null;
  nextPost?: CollectionEntry<"posts"> | null;
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
const primaryTag = post.data.tags?.[0];
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <ReadingProgress />
  <div class="mx-auto w-full max-w-[1200px] px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_280px]">
      <main class="min-w-0 pt-12 pb-24">
        <article>
          <PostHeader
            title={post.data.title}
            createdAt={post.data.createdAt}
            body={post.body ?? ""}
            primaryTag={primaryTag}
          />
          <div class={cn(proseClasses, "max-w-[720px]")}>
            <Content />
          </div>
        </article>
        <FootNav prevPost={prevPost} nextPost={nextPost} />
      </main>
      <MarginRail />
    </div>
  </div>
</BaseLayout>
