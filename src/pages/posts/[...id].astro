---
import { cn } from "@/lib/utils";

import BaseLayout from "@/layouts/base-layout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { proseClasses } from "@/lib/prose";
import { readMinutes, wordCount } from "@/lib/read-time";
import { buildPostGraph, getBacklinks } from "@/lib/post-graph";
import { formatPostDate } from "@/lib/format-date";
import ReadingProgress from "@/components/post/reading-progress.astro";
import TagPill from "@/components/post/tag-pill.astro";
import PostFootNav from "@/components/post/post-foot-nav.astro";
import PostGraphMini from "@/components/graph/post-graph-mini";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const sortedPosts = [...posts].sort(
    (a, b) => b.data.createdAt.getTime() - a.data.createdAt.getTime(),
  );

  return sortedPosts.map((post, i) => ({
    params: { id: post.id },
    props: {
      post,
      prevPost: sortedPosts[i + 1] ?? null,
      nextPost: sortedPosts[i - 1] ?? null,
    },
  }));
}

interface Props {
  post: CollectionEntry<"posts">;
  prevPost?: CollectionEntry<"posts"> | null;
  nextPost?: CollectionEntry<"posts"> | null;
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

const body = post.body ?? "";
const minutes = readMinutes(body);
const words = wordCount(body);
const primaryTag = post.data.tags?.[0];

const dateLabel = formatPostDate(post.data.createdAt)?.toUpperCase();

const allPosts = await getCollection("posts");
const graph = buildPostGraph(allPosts);
const backlinks = getBacklinks(allPosts, post.id);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <ReadingProgress />
  <div class="mx-auto w-full max-w-[1280px] px-8 pt-12 pb-24 max-md:px-4">
    <div
      class="grid grid-cols-1 gap-16 lg:grid-cols-[minmax(0,1fr)_280px]"
    >
      <article class="min-w-0">
        <header>
          <a
            href="/"
            class="inline-block font-mono text-[11px] uppercase tracking-[0.04em] text-fg-3 transition-colors hover:text-fg-1"
          >
            ← all writing
          </a>
          {
            primaryTag && (
              <div class="mt-6">
                <TagPill tag={primaryTag} />
              </div>
            )
          }
          <h1
            class="mt-4 text-[44px] font-extrabold leading-[1.1] tracking-[-0.04em] text-fg-1 max-md:text-[32px]"
          >
            {post.data.title}
          </h1>
          <p class="mt-4 max-w-[64ch] text-lg leading-[1.6] text-fg-2">
            {post.data.description}
          </p>
          <div
            class="mt-6 font-mono text-[11px] uppercase tracking-[0.04em] text-fg-3"
          >
            <time datetime={post.data.createdAt.toISOString()}>
              {dateLabel}
            </time>
            <span class="px-1.5">·</span>
            <span>{minutes} MIN</span>
            <span class="px-1.5">·</span>
            <span>{words} WORDS</span>
          </div>
          <hr class="mt-10 border-border" />
        </header>
        <div class={cn(proseClasses, "mt-10 max-w-[720px]")}>
          <Content />
        </div>
        <PostFootNav prevPost={prevPost} nextPost={nextPost} />
      </article>
      <aside
        data-margin-rail
        class="mt-12 lg:mt-0 lg:sticky lg:top-[92px] lg:self-start"
        aria-label="margin rail"
      >
        <section class="border-l border-border pl-4">
          <p
            class="mb-3 font-mono text-[11px] uppercase tracking-[0.04em] text-fg-3"
          >
            neighborhood
          </p>
          <PostGraphMini
            client:only="react"
            nodes={graph.nodes}
            links={graph.links}
            activeId={post.id}
          />
        </section>
        {
          toc.length > 0 && (
            <section
              data-toc
              class="mt-8 border-l border-border pl-4"
            >
              <p class="mb-3 font-mono text-[11px] uppercase tracking-[0.04em] text-fg-3">
                on this page
              </p>
              <ul class="flex flex-col gap-0.5 leading-snug">
                {toc.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      data-toc-link
                      data-toc-slug={h.slug}
                      class:list={[
                        "block border-l-2 border-transparent py-1 text-fg-3 transition-colors hover:text-fg-1 data-[active=true]:border-brand-500 data-[active=true]:font-semibold data-[active=true]:text-fg-1",
                        h.depth === 3
                          ? "pl-7 text-xs"
                          : "pl-3 text-[13px]",
                      ]}
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        <section
          data-backlinks
          class="mt-8 border-l border-border pl-4"
        >
          <p
            class="mb-3 font-mono text-[11px] uppercase tracking-[0.04em] text-fg-3"
          >
            backlinks
            {
              backlinks.length > 0 && (
                <span class="ml-1 text-fg-3 opacity-60">{backlinks.length}</span>
              )
            }
          </p>
          {
            backlinks.length === 0 ? (
              <p class="text-xs leading-relaxed text-fg-3">
                no backlinks yet
              </p>
            ) : (
              <ul class="flex flex-col">
                {backlinks.map((bl, i) => (
                  <li
                    class:list={[
                      "border-dashed border-border",
                      i > 0 && "border-t",
                    ]}
                  >
                    <a
                      href={bl.href}
                      class="block py-3 pl-0 text-sm leading-snug text-fg-2 transition-[padding-left,color] hover:pl-1 hover:text-fg-1"
                    >
                      {bl.title}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  import { renderMermaidDiagrams } from "@/lib/mermaid-render";
  import {
    setupTocScrollSpy,
    TOC_TOP_OFFSET,
  } from "@/lib/toc-scroll-spy";

  renderMermaidDiagrams();

  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("a[data-toc-link]"),
  );
  if (links.length > 0) {
    const headings = links
      .map((link) => {
        const slug = link.dataset.tocSlug;
        if (!slug) return null;
        const el = document.getElementById(slug);
        return el ? { link, el } : null;
      })
      .filter((h): h is { link: HTMLAnchorElement; el: HTMLElement } => !!h);

    const scrollRoot =
      document.querySelector<HTMLElement>("[data-scroll-root]");

    setupTocScrollSpy({ headings, scrollRoot });

    // On desktop the [data-scroll-root] div scrolls; on mobile body-scroll,
    // scrollRoot has no scrollable height and we fall back to documentElement.
    // The active scroller can't change without a viewport-class change, so
    // cache after the first non-zero measurement to skip a layout flush per
    // TOC click.
    let cachedScroller: HTMLElement | null = null;
    function getScroller(): HTMLElement {
      if (cachedScroller) return cachedScroller;
      if (scrollRoot && scrollRoot.scrollHeight - scrollRoot.clientHeight > 1) {
        cachedScroller = scrollRoot;
        return scrollRoot;
      }
      // Don't cache documentElement until we've confirmed scrollRoot is
      // genuinely not the scroller (i.e., it has no scrollable content yet).
      // Early measurements may return zero before layout.
      if (scrollRoot && scrollRoot.scrollHeight === 0) {
        return document.documentElement;
      }
      cachedScroller = document.documentElement;
      return cachedScroller;
    }

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );

    for (const { link, el } of headings) {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        const scroller = getScroller();
        const top =
          el.getBoundingClientRect().top +
          scroller.scrollTop -
          TOC_TOP_OFFSET;
        scroller.scrollTo({
          top,
          behavior: reducedMotion.matches ? "auto" : "smooth",
        });
        history.replaceState(null, "", `#${el.id}`);
      });
    }
  }
</script>
