---
import { cn } from "@/lib/utils";

import BaseLayout from "@/layouts/base-layout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { proseClasses } from "@/lib/prose";
import PostNavigation from "@/components/islands/post-navigation.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const sortedPosts = posts.sort(
    (a, b) => b.data.createdAt.getTime() - a.data.createdAt.getTime(),
  );

  return sortedPosts.map((post) => {
    const currentIndex = sortedPosts.findIndex((p) => p.id === post.id);
    const prevPost =
      currentIndex + 1 < sortedPosts.length
        ? sortedPosts[currentIndex + 1]
        : null;
    const nextPost =
      currentIndex - 1 >= 0 ? sortedPosts[currentIndex - 1] : null;

    return {
      params: { id: post.id },
      props: { post, prevPost, nextPost },
    };
  });
}

interface Props {
  post: CollectionEntry<"posts">;
  prevPost?: CollectionEntry<"posts"> | null;
  nextPost?: CollectionEntry<"posts"> | null;
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article
    class={cn(
      "mx-auto w-full lg:w-250 xl:w-300 2xl:w-380",
      "rounded border bg-card text-card-foreground shadow-xs p-5 sm:p-6",
    )}
  >
    <header class="flex flex-col gap-2">
      <h1 class="text-xl font-bold leading-tight tracking-tight">
        {post.data.title}
      </h1>
      <div class="text-muted-foreground text-sm flex flex-wrap gap-2">
        <time datetime={post.data.createdAt.toISOString()}>
          {post.data.createdAt.toLocaleDateString("ko-KR")}
        </time>
        {
          post.data.tags?.length && (
            <span aria-label="tags">
              {post.data.tags.map((tag) => `#${tag}`).join(" ")}
            </span>
          )
        }
      </div>
    </header>
    <div class={cn(proseClasses, "mt-6 mb-12")}>
      <Content />
    </div>
    <PostNavigation prevPost={prevPost} nextPost={nextPost} />
  </article>
</BaseLayout>
