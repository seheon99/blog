---
import { cn } from "@/lib/utils";

import BaseLayout from "@/layouts/base-layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";

export function getStaticPaths() {
  return getCollection("posts").then((posts) =>
    posts.map((post) => ({
      params: { id: post.slug },
      props: { post },
    }))
  );
}

const { post } = Astro.props as { post: CollectionEntry<"posts"> };
const { Content } = await post.render();
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article
    class={cn(
      "mx-auto w-full lg:w-250 xl:w-300 2xl:w-380",
      "rounded border bg-card text-card-foreground shadow-xs p-5 sm:p-6"
    )}
  >
    <header class="flex flex-col gap-2">
      <h1 class="text-xl font-bold leading-tight tracking-tight">
        {post.data.title}
      </h1>
      <div class="text-muted-foreground text-sm flex flex-wrap gap-2">
        <time datetime={new Date(post.data.publishedAt).toISOString()}>
          {new Date(post.data.publishedAt).toLocaleDateString("ko-KR")}
        </time>
        {post.data.tags?.length && (
          <span aria-label="tags">
            {post.data.tags.map((tag) => `#${tag}`).join(" ")}
          </span>
        )}
      </div>
    </header>
    <div class="prose prose-neutral mt-6 max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
