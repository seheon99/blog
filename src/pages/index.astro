---
import BaseLayout from "@/layouts/base-layout.astro";
import WritingRow from "@/components/post/writing-row.astro";
import { readMinutes } from "@/lib/read-time";
import { getCollection } from "astro:content";

const initialView =
  Astro.url.searchParams.get("view") === "graph" ? "graph" : "list";

const posts = (await getCollection("posts"))
  .sort((a, b) => b.data.createdAt.getTime() - a.data.createdAt.getTime())
  .map((post) => ({
    href: `/posts/${post.id}`,
    title: post.data.title,
    description: post.data.description,
    createdAt: post.data.createdAt,
    readMinutes: readMinutes(post.body ?? ""),
    primaryTag: post.data.tags?.[0],
  }));
---

<BaseLayout title="seheon blog" description="글 목록">
  <section data-view-pane="list" hidden={initialView !== "list"}>
    <main class="mx-auto w-full max-w-[760px] px-6 pt-12 pb-24">
      <h1 class="text-[40px] font-extrabold leading-tight tracking-[-0.04em] text-fg-1">
        글
      </h1>
      <p class="mt-2 mb-10 text-sm text-fg-3">
        {posts.length}개의 글
      </p>
      <div class="flex flex-col">
        {posts.map((post) => <WritingRow {...post} />)}
      </div>
    </main>
  </section>
  <section data-view-pane="graph" hidden={initialView !== "graph"}>
    <p class="mx-auto w-full max-w-prose p-4 text-fg-3">
      Graph view coming soon.
    </p>
  </section>
</BaseLayout>

<script>
  function readViewFromURL() {
    return new URLSearchParams(location.search).get("view") === "graph"
      ? "graph"
      : "list";
  }

  function applyView(view: string) {
    document.querySelectorAll<HTMLElement>("[data-view-pane]").forEach((el) => {
      el.hidden = el.dataset.viewPane !== view;
    });
    document
      .querySelectorAll<HTMLAnchorElement>("a[data-view-target]")
      .forEach((link) => {
        link.dataset.current =
          link.dataset.viewTarget === view ? "true" : "false";
      });
  }

  document
    .querySelectorAll<HTMLAnchorElement>("a[data-view-target]")
    .forEach((link) => {
      link.addEventListener("click", (event) => {
        const view = link.dataset.viewTarget;
        if (!view) return;
        event.preventDefault();
        history.pushState({ view }, "", `/?view=${view}`);
        applyView(view);
      });
    });

  window.addEventListener("popstate", () => {
    applyView(readViewFromURL());
  });
</script>
