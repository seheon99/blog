---
import { cn } from "@/lib/utils";

interface Props {
  soft?: boolean;
  class?: string;
}

const { soft = false, class: className, ...props } = Astro.props;
---

<hr
  role="presentation"
  {...props}
  class={cn(
    className,
    "w-full border-t",
    soft && "border-zinc-950/5 dark:border-white/5",
    !soft && "border-zinc-950/10 dark:border-white/10"
  )}
/>
