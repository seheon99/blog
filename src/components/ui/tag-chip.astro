---
import { tagColor } from "@/lib/tag-colors";

interface Props {
  tag: string | null;
  label?: string;
  active?: boolean;
  href: string;
}

const { tag, label, active = false, href } = Astro.props;
const swatch = tag ? tagColor(tag) : null;
---

<a
  href={href}
  data-tag-chip
  data-tag={tag ?? ""}
  data-current={active ? "true" : "false"}
  class:list={[
    "inline-flex items-center gap-1.5 rounded-full border border-border px-3 py-[5px] text-xs font-medium tracking-[0.02em] text-fg-3 transition-colors hover:text-fg-1",
    "data-[current=true]:bg-fg-1 data-[current=true]:text-bg-1 data-[current=true]:border-fg-1 data-[current=true]:hover:text-bg-1",
  ]}
>
  {
    swatch && (
      <span
        aria-hidden="true"
        class="inline-block h-2 w-2 rounded-full"
        style={`background-color: ${swatch}`}
      />
    )
  }
  {label ?? tag ?? "all"}
</a>
