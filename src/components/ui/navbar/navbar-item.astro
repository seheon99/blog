---
import { cn } from "@/lib/utils";

interface Props {
  href?: string;
  current?: boolean;
  class?: string;
  [key: string]: unknown;
}

const { href, current, class: className, ...props } = Astro.props;
const Tag = href ? "a" : "button";
---

<span
  class={cn("relative", className)}
  data-current={current ? "true" : "false"}
>
  <span
    aria-hidden="true"
    class="navbar-current-indicator absolute inset-x-2 -bottom-2.5 h-0.5 rounded-full bg-foreground opacity-0 transition-opacity"
  ></span>
  <Tag
    href={href}
    {...props}
    data-current={current ? "true" : undefined}
    class={cn(
      "relative flex min-w-0 items-center gap-3 rounded-lg p-2 text-left text-base/6 font-medium text-foreground sm:text-sm/5",
      "*:data-[slot=icon]:size-6 *:data-[slot=icon]:shrink-0 *:data-[slot=icon]:fill-muted-foreground sm:*:data-[slot=icon]:size-5",
      "*:not-nth-2:last:data-[slot=icon]:ml-auto *:not-nth-2:last:data-[slot=icon]:size-5 sm:*:not-nth-2:last:data-[slot=icon]:size-4",
      "*:data-[slot=avatar]:-m-0.5 *:data-[slot=avatar]:size-7 sm:*:data-[slot=avatar]:size-6",
      "hover:bg-accent hover:*:data-[slot=icon]:fill-foreground",
      "active:bg-accent active:*:data-[slot=icon]:fill-foreground",
      !href && "cursor-default",
    )}
  >
    <slot />
  </Tag>
</span>

<style>
  [data-current="true"] > .navbar-current-indicator {
    opacity: 1;
  }
</style>
