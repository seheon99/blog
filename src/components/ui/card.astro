---
import { cn } from "@/lib/utils";

interface Props {
  href?: string;
  class?: string;
}

const { href, class: className, ...props } = Astro.props;
const Container = href ? "a" : "div";
---

<Container
  href={href}
  {...props}
  class={cn(
    "bg-card text-card-foreground block rounded border shadow-xs w-fit",
    href &&
      "hover:bg-accent/40 focus-visible:ring-ring focus-visible:ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2",
    className
  )}
>
  <slot />
</Container>
