---
import { cn } from "@/lib/utils";

interface Props {
  href?: string;
  class?: string;
}

const { href, class: className, ...props } = Astro.props;
const Container = href ? "a" : "div";
---

<Container
  href={href}
  {...props}
  class={cn(
    "bg-card text-card-foreground relative isolate block w-fit overflow-hidden rounded-xl border border-border transition duration-200",
    href &&
      "hover:-translate-y-0.5 hover:shadow-lg hover:shadow-black/10 hover:bg-accent focus-visible:ring-ring focus-visible:ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2",
    className
  )}
>
  <slot />
</Container>
