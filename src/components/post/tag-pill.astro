---
import { tagColor } from "@/lib/tag-colors";

interface Props {
  tag: string;
}

const { tag } = Astro.props;
---

<span
  class="inline-flex items-center rounded-full px-3 py-[3px] font-mono text-[11px] font-medium uppercase tracking-[0.04em] text-bg-1"
  style={`background-color: ${tagColor(tag)}`}
>
  #{tag}
</span>
