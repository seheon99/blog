---
import type { CollectionEntry } from "astro:content";
import { ArrowLeft, ArrowRight } from "@lucide/astro";

interface Props {
  prevPost?: CollectionEntry<"posts"> | null;
  nextPost?: CollectionEntry<"posts"> | null;
}

const { prevPost, nextPost } = Astro.props;
---

{
  (prevPost || nextPost) && (
    <nav
      aria-label="post pagination"
      class="mt-16 grid grid-cols-1 gap-px border-t border-border pt-10 sm:grid-cols-2 sm:gap-6"
    >
      {prevPost ? (
        <a
          href={`/posts/${prevPost.id}`}
          class="group flex flex-col gap-2 py-4 transition-[padding] duration-150 hover:pr-1.5 sm:items-start"
          rel="prev"
        >
          <span class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.06em] text-fg-3">
            <ArrowLeft class="size-3.5" />
            Previous
          </span>
          <span class="text-[15px] font-medium leading-snug text-fg-1 transition-colors duration-100 group-hover:text-brand-600">
            {prevPost.data.title}
          </span>
        </a>
      ) : (
        <div />
      )}
      {nextPost ? (
        <a
          href={`/posts/${nextPost.id}`}
          class="group flex flex-col gap-2 py-4 transition-[padding] duration-150 hover:pl-1.5 sm:items-end sm:text-right"
          rel="next"
        >
          <span class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.06em] text-fg-3">
            Next
            <ArrowRight class="size-3.5" />
          </span>
          <span class="text-[15px] font-medium leading-snug text-fg-1 transition-colors duration-100 group-hover:text-brand-600">
            {nextPost.data.title}
          </span>
        </a>
      ) : (
        <div />
      )}
    </nav>
  )
}
