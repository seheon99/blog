---
import { readMinutes } from "@/lib/read-time";
import { formatPostDate } from "@/lib/format-date";

interface Props {
  title: string;
  createdAt: Date;
  body: string;
  primaryTag?: string;
}

const { title, createdAt, body, primaryTag } = Astro.props;

const dateTime = createdAt.toISOString();
const dateLabel = formatPostDate(createdAt)?.toUpperCase();
const minutes = readMinutes(body);
---

<header class="mb-10 flex flex-col gap-5">
  {
    primaryTag && (
      <a
        href={`/?tag=${encodeURIComponent(primaryTag)}`}
        class="inline-flex w-fit items-center rounded-full border border-border px-3 py-1 font-mono text-[11px] uppercase tracking-[0.06em] text-fg-3 transition-colors hover:border-brand-600 hover:text-brand-600"
      >
        #{primaryTag}
      </a>
    )
  }
  <h1
    class="text-[34px] sm:text-[40px] font-extrabold leading-[1.15] tracking-[-0.03em] text-fg-1"
  >
    {title}
  </h1>
  <div
    class="font-mono text-[11px] uppercase tracking-[0.04em] text-fg-3"
  >
    <time datetime={dateTime}>{dateLabel}</time>
    <span class="px-1.5">·</span>
    <span>{minutes} MIN</span>
  </div>
</header>
