---
// Phase 4 placeholder. Phases 5–6 fill in the mini-graph, scroll-spy TOC,
// and backlinks. Each section keeps a 1px left rule + uppercase mono label
// so the future content has a stable home.
type Section = { label: string; note: string };

const sections: Section[] = [
  { label: "On this page", note: "TOC arrives with phase 6." },
  { label: "Map", note: "Mini graph arrives with phase 5." },
  { label: "Backlinks", note: "Backlinks arrive with phase 6." },
];
---

<aside
  data-margin-rail
  aria-label="margin rail"
  class="hidden lg:block w-[280px] shrink-0"
>
  <div class="sticky top-[88px] flex flex-col gap-8">
    {
      sections.map((section) => (
        <section class="border-l border-border pl-4">
          <h3 class="font-mono text-[11px] uppercase tracking-[0.08em] text-fg-3">
            {section.label}
          </h3>
          <p class="mt-2 text-[13px] leading-5 text-fg-4">{section.note}</p>
        </section>
      ))
    }
  </div>
</aside>
