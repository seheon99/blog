---
import { cn } from "@/lib/utils";
import Card from "@/components/ui/card.astro";
import Divider from "@/components/ui/divider.astro";

interface Props {
  href: string;
  title: string;
  description: string;
  publishedAt: string;
  tags?: string[];
  thumbnailUrl?: string;
  thumbnailAlt?: string;
  thumbnailRatio?: number;
  class?: string;
}

const {
  href,
  title,
  description,
  publishedAt,
  tags,
  thumbnailUrl,
  thumbnailAlt = "",
  class: className,
} = Astro.props;

const dateTime = new Date(publishedAt).toISOString();
const dateLabel = new Date(publishedAt).toLocaleDateString("ko-KR");
---

<Card href={href} class={cn("w-full aspect-3/4", className)} aria-label={title}>
  <article class="size-full flex flex-col">
    <div class="aspect-video overflow-hidden rounded-t">
      <img
        src={thumbnailUrl}
        alt={thumbnailAlt}
        loading="lazy"
        decoding="async"
        class="size-full object-cover"
      />
    </div>
    <div class="p-4 sm:p-5 flex flex-col justify-between flex-1">
      <div>
        <time
          class="text-muted-foreground mt-0.5 shrink-0 text-xs"
          datetime={dateTime}
        >
          {dateLabel}
        </time>
        <h3
          class="mt-2 text-base font-semibold leading-snug tracking-tight truncate"
        >
          {title}
        </h3>
        <p
          class="mt-4 text-muted-foreground text-sm leading-relaxed line-clamp-3"
        >
          {description}
        </p>
      </div>
      {
        tags?.length && (
          <div>
            <Divider soft />
            <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="tags">
              {tags.map((tag) => (
                <li class="bg-secondary text-secondary-foreground rounded-md px-2 py-0.5 text-xs">
                  {tag}
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </article>
</Card>
