---
import { cn } from "@/lib/utils";
import type { CollectionEntry } from "astro:content";
import PostNavigationButton from "./post-navigation-button.astro";

interface Props {
  prevPost?: CollectionEntry<"posts"> | null;
  nextPost?: CollectionEntry<"posts"> | null;
}

const { prevPost, nextPost } = Astro.props;
---

<nav
  aria-label="pagination"
  class={cn(
    "relative flex flex-col gap-4 sm:flex-row justify-between items-start w-full",
    "my-12 border-t border-gray-200 dark:border-gray-800 pt-8",
    "[&_a]:no-underline",
  )}
>
  {
    prevPost ? (
      <PostNavigationButton post={prevPost} direction="prev" label="Previous" />
    ) : (
      <div />
    )
  }

  {
    nextPost ? (
      <PostNavigationButton post={nextPost} direction="next" label="Next" />
    ) : (
      <div />
    )
  }
</nav>
